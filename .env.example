# Public port used by docker compose (web UI + API proxy)
APP_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Optional API key. When set, clients must send it in the x-api-key header.
API_KEY=

# Batch processing
MAX_BATCH_SIZE=500
BATCH_CONCURRENCY=4
MAX_PAYLOAD=12mb
JOB_TTL_MINUTES=60

# Storage paths inside the API container (persisted through the qr-storage volume)
STORAGE_PATH=/app/storage
TEMP_PATH=/app/storage/temp

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
CORS_ORIGIN=*
